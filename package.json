{
  "name": "@collana-solutions/react-utils",
  "version": "1.1.2",
  "description": "todo @drebrez",
  "homepage": "https://github.com/collana-solutions/react-utils",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/collana-solutions/react-utils"
  },
  "license": "MIT",
  "author": "collana solutions AG",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.modern.js",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.modern.js",
  "source": "src/index.ts",
  "jsnext:main": "dist/index.modern.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c --configPlugin rollup-plugin-typescript2",
    "lint": "eslint --cache",
    "prepack": "pnpm run build",
    "prepare-pr": "pnpm exec prettier . --write && pnpm run lint && pnpm run build && pnpm run test",
    "prettier-check": "prettier --check .",
    "prettier-write": "prettier --write .",
    "start": "pnpm run build --watch",
    "test": "cypress run --component",
    "test:all": "pnpm run test && pnpm run test:cypress",
    "start-all": "concurrently \"pnpm run start\" \"pnpm run start-yalc\"",
    "start-yalc": "nodemon --watch dist -x \"yalc push\"",
    "storybook": "start-storybook -p 6006",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@collana-solutions/eslint-config": "^3.1.1",
    "@popperjs/core": "^2.11.7",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/rollup-plugin-peer-deps-external": "^2.2.6",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "cypress": "^16.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.2",
    "jest-localstorage-mock": "^2.4.26",
    "jiti": "^2.6.1",
    "nodemon": "^3.1.14",
    "pkg-pr-new": "^0.0.93",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rollup": "^4.32.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-typescript2": "^0.37.0",
    "shx": "^0.4.0",
    "ts-jest": "^29.1.1",
    "tsconfig-paths-webpack-plugin": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "webpack": "^5.82.0",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.2.0",
    "react-dom": "^18.2.0 || ^19.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "pnpm@11.22.0"
}
